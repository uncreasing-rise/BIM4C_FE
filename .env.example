# Public values (embedded into the browser bundle at build time)
# Local development values are provided by .env.development.local.
# Production Vercel values:
# NEXT_PUBLIC_API_URL=https://bim4c-be.vercel.app
# NEXT_PUBLIC_APP_URL=https://www.bim4c.vn
# NEXT_PUBLIC_CDN_URL=https://htnnznnjxmfnjhihusqr.supabase.co
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CDN_URL=
# Optional webmaster verification tokens; leave unset until issued by the owner
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Server-only values
# Production Vercel value: https://bim4c-be.vercel.app
BACKEND_URL=http://localhost:8080
REVALIDATION_SECRET=replace-with-at-least-32-random-characters

# Optional; defaults to bim4c_admin_session and must match BE when overridden
# AUTH_COOKIE_NAME=bim4c_admin_session
