# Required in production. Public HTTPS URL of the BIM4C backend.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_APP_URL=https://www.example.com
# Required when public content uses remote media (for Supabase: the project URL).
NEXT_PUBLIC_CDN_URL=
# Must be false in production.
NEXT_PUBLIC_USE_MOCK_API=false
# Server-only backend URL, preferably the private/internal service URL.
BACKEND_URL=http://backend:8080
# Exact browser origin allowed by the backend.
FRONTEND_URL=https://www.example.com
AUTH_COOKIE_NAME=bim4c_admin_session
# Server-only and identical to the backend value.
REVALIDATION_SECRET=replace-with-at-least-32-random-characters
